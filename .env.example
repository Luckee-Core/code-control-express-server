PORT=3010
NODE_ENV=development

# --- Studio direct (local code-generator-storage-server :3080) ---
CODE_CONTROL_STORAGE_URL=http://127.0.0.1:3080
CODE_CONTROL_STORAGE_SECRET=

# --- Laptop → studio main gateway :3010 (no storage secret on laptop) ---
# MAIN_GATEWAY_URL=http://10.0.0.28:3010
# DISPATCHER_GATE_SECRET=
# STORAGE_ACCESS_MODE=gateway

# STORAGE_REQUEST_TIMEOUT_MS=10000

# --- Studio-local Postgres copy ---
# STORAGE_IMPORT_TARGET_URL=http://127.0.0.1:3080
# TEMP_MIGRATION_ENABLED=true
# LAPTOP_CODE_CONTROL_STORAGE_URL=http://<LAPTOP_LAN_IP>:3080

# --- Required — GitHub repo creation ---
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_TEMPLATE_EXPRESS=your-github-org/code-control-express-server
GITHUB_TEMPLATE_PYTHON=your-github-org/python-server-template
GITHUB_TEMPLATE_WEB=your-github-org/code-control
GITHUB_TEMPLATE_REACT_NATIVE=your-github-org/react-native-template
GITHUB_OWNER=
GITHUB_ALLOWED_OWNERS=
PROJECT_SETUP_REPO_NAME_WEB={slug}-web
PROJECT_SETUP_REPO_NAME_REACT_NATIVE={slug}-react-native
