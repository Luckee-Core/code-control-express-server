PORT=3010
NODE_ENV=development

# --- Required — local Postgres ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/code_control

# --- One-time import from Supabase (npm run db:import-from-supabase) ---
# SUPABASE_URL=your-project-url.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Required — GitHub repo creation ---
# Classic PAT with repo scope. See docs/oss-quickstart.md#connect-github
GITHUB_PERSONAL_ACCESS_TOKEN=
# Template repos as owner/repo (must be marked Template in GitHub Settings)
GITHUB_TEMPLATE_EXPRESS=your-github-org/code-control-express-server
GITHUB_TEMPLATE_PYTHON=your-github-org/python-server-template
GITHUB_TEMPLATE_WEB=your-github-org/code-control
GITHUB_TEMPLATE_REACT_NATIVE=your-github-org/react-native-template

# --- Optional — org targeting ---
# Default owner for new repos if different from template owner
GITHUB_OWNER=
# Comma-separated allowlist; server rejects create for owners not listed
GITHUB_ALLOWED_OWNERS=
# Web repo name pattern when creating from template (default: {slug}-web)
PROJECT_SETUP_REPO_NAME_WEB={slug}-web
PROJECT_SETUP_REPO_NAME_REACT_NATIVE={slug}-react-native
